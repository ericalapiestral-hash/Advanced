# ===== Unity (프로젝트 폴더: Game/) =====
/Game/[Ll]ibrary/
/Game/[Tt]emp/
/Game/[Oo]bj/
/Game/[Bb]uild/
/Game/[Bb]uilds/
/Game/[Ll]ogs/
/Game/[Uu]ser[Ss]ettings/
/Game/[Mm]emoryCaptures/
/Game/[Rr]ecordings/
/Game/[Aa]ssets/Plugins/Editor/JetBrains*
/Game/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*
/Game/[Aa]ssets/[Ss]treamingAssets/aa.meta
/Game/[Aa]ssets/[Ss]treamingAssets/aa/*

# 저장소 루트에 둔 빌드 결과물
/[Bb]uild/
/[Bb]uilds/

# ===== 개인 자료 (절대 커밋하지 않음) =====
# 추억 원본 사진 등. 도트로 변환한 최종본만 Game/Assets/_Project/ 안에 넣는다
/private/

# ===== tools/ (밸런스 시뮬레이터, 헤드리스 테스트) =====
/tools/**/bin/
/tools/**/obj/
__pycache__/
.venv/

# ===== IDE / 자동 생성 파일 =====
.vs/
.vscode/
.idea/
.gradle/
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
# tools/의 테스트 프로젝트는 Unity가 만든 파일이 아니므로 커밋한다
!/tools/**/*.csproj
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
*.pidb.meta
*.pdb.meta
*.mdb.meta
sysinfo.txt
crashlytics-build.properties

# ===== 패키지 / 빌드 파일 =====
*.apk
*.aab
*.app
*.unitypackage

# ===== OS =====
.DS_Store
Thumbs.db
desktop.ini
